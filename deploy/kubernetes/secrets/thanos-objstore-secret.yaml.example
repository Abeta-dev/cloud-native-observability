apiVersion: v1
kind: Secret
metadata:
  name: thanos-objstore-secret
  namespace: monitoring
  labels:
    app.kubernetes.io/name: thanos
    app.kubernetes.io/part-of: kube-prometheus-stack
    tier: observability
type: Opaque
stringData:
  # Thanos object storage configuration file.
  # For AWS EKS using IRSA (IAM Roles for Service Accounts), leave access_key and secret_key
  # unset or empty; the AWS Go SDK will automatically discover pod identity credentials.
  thanos.yaml: |
    type: S3
    config:
      bucket: cno-thanos-metrics-prod
      endpoint: s3.us-east-1.amazonaws.com
      insecure: false
      signature_version2: false
    # For Google Cloud GKE using Workload Identity:
    # type: GCS
    # config:
    #   bucket: cno-thanos-metrics-prod
