apiVersion: v1
kind: Secret
metadata:
  name: grafana-admin-credentials
  namespace: monitoring
  labels:
    app.kubernetes.io/name: grafana
    app.kubernetes.io/part-of: kube-prometheus-stack
    tier: observability
type: Opaque
stringData:
  admin-user: admin
  admin-password: "REPLACE_WITH_SECURE_ADMIN_PASSWORD"
